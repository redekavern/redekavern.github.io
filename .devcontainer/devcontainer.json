// .devcontainer/devcontainer.json
{
  "name": "Vitepress Dev Environment",

  // Utilise le compose Docker du projet pour partager le même réseau avec le backend p35
  "image": "node:26.5-slim",
    
  "features": {
    "ghcr.io/devcontainers/features/git:1": {"version": "latest"}

    // Permet au conteneur de parler au Docker de la machine locale
    // "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },

  // Ouvre le port 3000 (le port par défaut de Nuxt) sur votre machine locale
  "forwardPorts": [3000],

  // Configure des extensions VS Code qui s'installeront automatiquement DANS le conteneur
  "customizations": {
    "vscode": {
      "extensions": [
        "Vue.volar",
        "dbaeumer.vscode-eslint"
      ]
    }
  },

  // Commande exécutée après la création du conteneur pour installer vos dépendances
  "postCreateCommand": "npm install -g npm@12.0.1 && npm install"
}